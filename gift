# Commands that never move HEAD, so they never change .gift-refs in HEAD
head_fixed_cmds = {"add", "blame", "branch", "diff", "grep", "log", "ls-files", "rev-parse", "show", "status"}

logger = logging.getLogger(__name__)


class GiftError(Exception):
    def __init__(self, msg: str) -> None:
        super(GiftError, self).__init__(msg)
        self.returncode = 2
        self.out: list[str] = []
        self.err = [msg]


def is_relative_path(url: str) -> bool:
    # git reads a url as a local path if it has no "://" and no ":" before
    # its first "/", as in "host:path". git expands a leading "~" itself.
    if url == "" or "://" in url:
        return False

    colon = url.find(":")
    slash = url.find("/")
    has_host = colon != -1 and (slash == -1 or colon < slash)
    if has_host:
        return False

    return not os.path.isabs(url) and not url.startswith("~")


class Upstream(TypedDict):
    name: str
    url: str
    branch: str


class SubRepoConf(TypedDict):
    # One sub-repo entry of .gift, as Gift.parse_conf() expands it
    dir: str
    upstream: Upstream
    refhead: str
    sub_gitdir: str
    env: dict[str, str]
    bareenv: dict[str, str]


class Gift(object):
    """
    """

    # inside gitdir:
    sub_gitdir_fmt = "gift/subdir/{dir}"

    def __init__(self, gitopt: GitOpt) -> None:
        self.gitopt = gitopt.clone()
        if self.gitopt.opt.get('exec_path') is None:
            self.gitpath = 'git'
        else:
            self.gitpath = pjoin(self.gitopt.opt['exec_path'], 'git')
        self.in_git_dir = False

        # When multiple -C options are given, each subsequent non-absolute -C
        # <path> is interpreted relative to the preceding -C <path>.

        startpath = pabs(".")
        for path in self.gitopt.opt['startpath']:
            startpath = prebase(startpath, path)

        self.startpath = startpath
        self.cwd = self.startpath
        # Git objects run in self.cwd, so passing -C to git would apply it twice
        self.gitopt.opt['startpath'] = []

        # As in git, --git-dir and --work-tree override GIT_DIR and GIT_WORK_TREE
        git_dir = self.gitopt.opt['git_dir']
        if git_dir is None:
            git_dir = os.environ.get('GIT_DIR')

        work_tree = self.gitopt.opt['work_tree']
        if work_tree is None:
            work_tree = os.environ.get('GIT_WORK_TREE')

        self.git_dir = prebase(self.startpath, git_dir)
        self.working_dir = prebase(self.startpath, work_tree)

        # A repo named by the user is used even in a sub-repo dir
        self.repo_named = git_dir is not None or work_tree is not None

    def init_git_config(self) -> None:

        git_dir_specified = self.git_dir is not None

        if self.git_dir is None:
            # One git process for both dirs. In a git dir, --show-toplevel
            # fails after the git dir is printed.
            _, out, _ = cmdf(self.gitpath, "rev-parse", "--absolute-git-dir", "--show-toplevel", cwd=self.cwd)
            if len(out) > 0:
                self.git_dir = out[0]
            if len(out) > 1 and self.working_dir is None:
                self.working_dir = out[1]

        dd("git_dir:", self.git_dir)

        if self.git_dir is None:
            return

        if (self.cwd.startswith(self.git_dir + '/')
                or self.git_dir == self.cwd):
            self.in_git_dir = True

        if self.in_git_dir:
            return

        # git rev-parse --show-toplevel:
        # - With --git-dir=xx, it always returns current dir.
        # - Without --git-dir=xx, it might fail if cwd is not in a git repo
        if git_dir_specified:
            if self.working_dir is None:
                self.working_dir = self.cwd
            else:
                pass
        else:
            if self.working_dir is None:
                self.working_dir = cmd0(self.gitpath, "rev-parse", "--show-toplevel", cwd=self.cwd)

        dd("working_dir:", self.working_dir)

        self.confpath = self.working_dir + '/' + conf_filename
        self.conf = self.parse_conf()

    def parse_remote(self, subdir: str, remote: object) -> list[str]:
        usage = "{}: {}: expect <url>@<branch>, got: {!r}".format(conf_filename, subdir, remote)
        if not isinstance(remote, str):
            raise GiftError(usage)

        parts = remote.rsplit("@", 1)
        if len(parts) != 2 or parts[0] == '':
            raise GiftError(usage)

        url, branch = parts

        # An ssh url without a branch splits at "git@"; a branch name has no ":"
        if branch == '' or ':' in branch:
            raise GiftError(usage)

        # "ssh://git@host/path" without a branch splits after the user name,
        # which leaves a url without a path
        _, sep, rest = url.partition("://")
        if sep != '' and '/' not in rest:
            raise GiftError(usage)

        return ["origin", url, branch]

    def check_dir(self, subdir: object) -> None:
        # .gift comes with the repo, so a dir in it must not lead the sub-repo
        # checkout out of the work tree or into a git dir
        msg = "{}: {!r}: expect a dir inside the work tree and outside .git".format(conf_filename, subdir)
        if not isinstance(subdir, str):
            raise GiftError(msg)

        # realpath also follows a symlink that leads out of the work tree
        root = os.path.realpath(self.working_dir)
        path = os.path.realpath(pjoin(root, subdir))
        relpath = os.path.relpath(path, root)
        parts = relpath.lower().split(os.sep)

        if relpath == '.' or parts[0] == '..' or '.git' in parts:
            raise GiftError(msg)

    def read_conf(self) -> dict[str, Any]:
        try:
            with open(self.confpath, 'r') as f:
                content = f.read()
        except OSError:
            return {
                "dirs": {}
            }

        try:
            conf = yaml.safe_load(content)
        except yaml.MarkedYAMLError as e:
            msg = "{}: line {}: {}".format(conf_filename, e.problem_mark.line + 1, e.problem)
            raise GiftError(msg)

        # An empty .gift, like a missing one, has no sub-repo
        if conf is None:
            return {
                "dirs": {}
            }

        if not isinstance(conf, dict) or not isinstance(conf.get("dirs"), dict):
            raise GiftError(conf_filename + ": expect dirs: {<dir>: <url>@<branch>, ...}")

        return conf

    def parse_conf(self) -> dict[str, Any]:

        conf = self.read_conf()

        # rm = conf.get("remotes", {})
        dirs = conf["dirs"]

        for subdir in dirs:
            self.check_dir(subdir)
            remote_name, url, branch = self.parse_remote(subdir, dirs[subdir])

            # A relative url is relative to the super repo root, where .gift
            # is, but git resolves it against the cwd of each git process
            if is_relative_path(url):
                url = os.path.normpath(pjoin(self.working_dir, url))

            sub_gitdir = self.sub_gitdir_fmt.format(dir=subdir)
            subrepo: SubRepoConf = {
                "dir": subdir,
                "upstream": {
                    "name": remote_name,
                    "url": url,
                    "branch": branch,
                },
                "refhead": "refs/gift/sub/{dir}".format(dir=subdir),
                "sub_gitdir": sub_gitdir,
                "env": {
                    "GIT_DIR": pjoin(self.git_dir, sub_gitdir),
                    "GIT_WORK_TREE": pjoin(self.working_dir, subdir),
                    # "GIT_OBJECT_DIRECTORY": pjoin(self.git_dir, "objects"),
                },
                "bareenv": {
                    "GIT_DIR": pjoin(self.git_dir, sub_gitdir),
                },
            }
            dirs[subdir] = subrepo

        return conf

    def _super_git(self, root: bool = False) -> Git:
        if root:
            # Tree objects hold paths from the work-tree root, but k3git's
            # tree_items() lists a tree relative to cwd. Absolute dirs keep
            # a relative --git-dir or --work-tree from resolving against
            # the root.
            return Git(
                self.gitopt,
                gitpath=self.gitpath,
                gitdir=self.git_dir,
                working_dir=self.working_dir,
                cwd=self.working_dir,
            )

        return Git(
            self.gitopt,
            gitpath=self.gitpath,
            cwd=self.cwd,
        )

    def _sub_git(self, subrepo: SubRepoConf, bare: bool = False) -> Git:
        git_dir = subrepo["env"]["GIT_DIR"]
        working_dir = subrepo["env"]["GIT_WORK_TREE"]

        if bare:
            return Git(
                self.gitopt,
                gitpath=self.gitpath,
                gitdir=git_dir,
                cwd=self.cwd,
                ctxmsg='GIFT: ' + subrepo['dir'],
            )
        else:
            return Git(
                self.gitopt,
                gitpath=self.gitpath,
                gitdir=git_dir,
                working_dir=working_dir,
                cwd=self.cwd,
                ctxmsg='GIFT: ' + subrepo['dir'],
            )

    def check_worktree(self, subrepo: SubRepoConf) -> None:
        self.try_init_sub_git(subrepo)
        self.try_init_sub_worktree(subrepo)

    def try_init_sub_git(self, subrepo: SubRepoConf) -> None:

        sub_gitdir_path = pjoin(self.git_dir, subrepo["sub_gitdir"])

        bare_env = subrepo['bareenv']
        upstream = subrepo["upstream"]

        if not os.path.isdir(sub_gitdir_path):
            # git init --bare fails with a GIT_WORK_TREE set for the super repo
            env = dict(os.environ)
            env.pop("GIT_DIR", None)
            env.pop("GIT_WORK_TREE", None)
            cmdx(self.gitpath, "init", "--bare", "--initial-branch=" + upstream["branch"], bare_env["GIT_DIR"],
                 env=env, inherit_env=False)
        else:
            dd("gitdir exist:", sub_gitdir_path)

        sub_git = self._sub_git(subrepo, bare=True)
        # The url as configured: `git remote get-url` expands url.<base>.insteadOf
        configured_url = sub_git.cmdf("config", "--get", "remote." + upstream["name"] + ".url", flag=CMD_NONE_ONELINE)
        if configured_url is None:
            dd("remote not found, add:", upstream)
            sub_git.out(2, "add remote:", upstream["name"], upstream["url"])
            sub_git.remote_add(upstream["name"], upstream["url"], capture=False)
        elif configured_url != upstream["url"]:
            sub_git.out(2, "set remote url:", upstream["name"], upstream["url"])
            sub_git.cmdf("remote", "set-url", upstream["name"], upstream["url"], flag=CmdFlag.RAISE)

        remote_head = sub_git.rev_of(upstream["name"] + '/' + upstream["branch"])
        if remote_head is None:
            dd("remote head not found:", upstream["name"] + '/' + upstream["branch"])
            dd("need fetch")
            sub_git.out(2, "fetch", upstream["name"], upstream["url"])
            sub_git.fetch(upstream["name"], flag=CMD_RAISE_PASS)

    def try_init_sub_worktree(self, subrepo: SubRepoConf) -> None:

        work_tree = subrepo['env']["GIT_WORK_TREE"]
        if not os.path.isdir(work_tree):
            os.makedirs(work_tree, mode=0o755)

        sub_git = self._sub_git(subrepo)
        if sub_git.rev_of("HEAD") is None:
            dd("HEAD not found:")

            upstream = subrepo['upstream']

            # If .gift-refs records a commit for this dir, the super repo has
            # already checked out its files: adopt it and keep the files.
            refs = []
            refs_path = pjoin(self.working_dir, refs_filename)
            if os.path.isfile(refs_path):
                content = fread(refs_path)
                refs = yaml.safe_load(content)

            recorded = dict(refs).get(subrepo['dir'])
            if recorded is None:
                sub_git.checkout(upstream["branch"])
            elif sub_git.obj_type(recorded) is None:
                msg = "{}: can not find commit {} recorded in {}; push it to {} from the clone that made it"
                raise GiftError(msg.format(subrepo['dir'], recorded, refs_filename, upstream['name']))
            else:
                upstream_branch = upstream['name'] + '/' + upstream['branch']
                sub_git.reset_to_commit('mixed', recorded)
                sub_git.cmdf('branch', '--set-upstream-to=' + upstream_branch, flag=CmdFlag.RAISE)

        self.try_switch_branch(sub_git, subrepo)

    def try_switch_branch(self, sub_git: Git, subrepo: SubRepoConf) -> None:
        # gift.branch is the .gift branch that the sub-repo was last set to.
        # A changed .gift branch moves the sub-repo once, so a branch that the
        # user checks out later stays.
        branch = subrepo['upstream']['branch']
        prev_branch = sub_git.cmdf("config", "--get", "gift.branch", flag=CMD_NONE_ONELINE)
        if prev_branch == branch:
            return

        # Without a record, as from an older gift, the sub-repo is taken as set
        if prev_branch is not None:
            change_msg = ".gift changed the branch from " + prev_branch + " to " + branch
            local_changes = sub_git.cmdf("status", "--porcelain", "--untracked-files=no", flag=CMD_RAISE_STDOUT)
            if local_changes != []:
                sub_git.out(2, "warning:", change_msg + ", but the work tree has local changes")
                return

            code, _, err = sub_git.cmdf("checkout", branch)
            if code != 0:
                sub_git.out(2, "warning:", change_msg + ", but checkout failed:")
                display(2, err)
                return
            sub_git.out(2, change_msg + ": checkout", branch)

        sub_git.cmdf("config", "gift.branch", branch, flag=CmdFlag.RAISE)

    def get_subrepo_config(self, subdir: str) -> tuple[str, SubRepoConf | None]:

        # TODO test subdir not in working_dir?
        working_dir = self.working_dir
        subdir = os.path.abspath(subdir)

        dd("working_dir:", working_dir)
        dd("subdir:", subdir)

        relpath = os.path.relpath(subdir, working_dir)
        if relpath.startswith('..'):
            dd("subdir is not in working_dir")
            return '', None

        dd("conf:", self.conf["dirs"])

        while relpath != '':
            dd("reldir:", relpath)
            if relpath in self.conf["dirs"]:
                return relpath, self.conf["dirs"][relpath]

            # trim last part.
            relpath, _ = os.path.split(relpath)
        else:
            return '', None

    def in_sub_repo_dir(self) -> bool:
        # Without .gift, a sub git dir tells that a dir is a sub-repo
        relpath = os.path.relpath(self.cwd, self.working_dir)
        if relpath.startswith('..'):
            return False

        while relpath not in ('', '.'):
            sub_gitdir = self.sub_gitdir_fmt.format(dir=relpath)
            if os.path.isfile(pjoin(self.git_dir, sub_gitdir, "HEAD")):
                return True
            relpath = os.path.dirname(relpath)

        return False

    def exec_informative_cmd(self, cmds: list[str]) -> None:
        cmd = cmds[0]
        if cmd == '--version':
            display(1, "gift version " + version)
            self._super_git().cmdf('--version', flag=CMD_RAISE_PASS)
        elif cmd == '--help':
            self._super_git().cmdf('--help', flag=CMD_RAISE_PASS)
            lines = [
                "",
                "Gift extended command:",
                "",
                "gift clone --sub <url>@<branch> <dir>",
                "    Add a sub-repo to <dir> by clone it from <url>, and checkout <branch>",
                "",
                "gift commit --sub [-m <msg>]",
                "    Add all sub-repo to super-repo and commit",
                "",
            ]
            # TODO finish them
            for line in lines:
                display(1, line)
        elif cmd in ('--exec-path',
                     '--man-path',
                     '--info-path',
                     '--html-path',
                     ):
            self._super_git().cmdf(cmd, flag=CMD_RAISE_PASS)

    def run_command(self, cmds: list[str]) -> None:

        dd("gift cmd:", cmds)

        # If a command does not need to be run inside a git repo, delegate it
        # and quit.
        if cmds[0] in ("init", "clone") and '--sub' not in cmds:
            # delegate to original git
            self._super_git().cmdf(*cmds, flag=CMD_RAISE_PASS)
            return

        conf_error = None
        try:
            self.init_git_config()
        except GiftError as e:
            conf_error = e

        if self.git_dir is None:
            self._super_git().cmdf(*cmds, flag=CMD_RAISE_PASS)
            return

        cmd, is_sub, cmds = self._strip_sub_flag(cmds)

        # A broken .gift, such as one in a merge conflict, must not block the
        # plain commands that fix it. In a sub-repo dir, such a command would
        # go to the super repo instead.
        if conf_error is not None:
            if is_sub or (not self.repo_named and self.in_sub_repo_dir()):
                raise conf_error
            display(2, "GIFT: warning: " + str(conf_error))
            self.conf = {"dirs": {}}

        follow_head = False
        if self.in_git_dir:
            if is_sub:
                raise GiftError("--sub can not be used in git-dir:" + self.git_dir)
            else:
                self._super_git().cmdf(*cmds, flag=CMD_RAISE_PASS)
        else:

            subdir, subrepo = '', None
            if not self.repo_named:
                subdir, subrepo = self.get_subrepo_config(self.cwd)
            dd("subdir:", subdir, subrepo)

            if subrepo is not None:
                self.check_worktree(subrepo)

            # TODO nested?
            if is_sub:

                if cmd == "init":
                    return self.x_init_sub(cmds)
                if cmd == "clone":
                    return self.x_clone_sub(cmds)
                elif cmd == 'commit':
                    return self.x_commit_sub(cmds)
                elif cmd == 'fetch':
                    return self.x_fetch_sub(cmds)
                elif cmd == 'merge':
                    return self.x_merge_sub(cmds)
                elif cmd == 'reset':
                    return self.x_reset_sub(cmds)

                raise GiftError("--sub is not supported for: " + cmd)

            if subrepo is not None:
                sub_git = self._sub_git(subrepo)
                sub_git.cmdf(*cmds, flag=CMD_RAISE_PASS)
            else:
                # Only a command on the super repo that can move HEAD can
                # change .gift-refs in HEAD
                follow_head = cmd not in head_fixed_cmds
                refs_before = None
                if follow_head:
                    # A parse error is reported by the read after the command
                    refs_before = self._get_head_refs(warn=False)

                super_git = self._super_git()
                super_git.cmdf(*cmds, flag=CMD_RAISE_PASS)
                # TODO run gift in a git-dir

        if not follow_head:
            return

        refs_after = self._get_head_refs(warn=True)
        if refs_before != refs_after and refs_after is not None:
            # A checkout or pull may have changed .gift. If the new one is
            # broken, the old one still maps each dir to its sub git dir.
            try:
                self.conf = self.parse_conf()
            except GiftError as e:
                display(2, "GIFT: warning: " + str(e))
            self._update_super_head_refs(refs_after)

    def _strip_sub_flag(self, cmds: list[str]) -> tuple[str, bool, list[str]]:

        cmd = cmds[0]
        cmds = cmds[1:]

        if '--' in cmds:
            i = cmds.index('--')
            args = cmds[:i]
        else:
            args = cmds

        is_sub = '--sub' in args
        if is_sub:
            cmds.remove('--sub')

        return cmd, is_sub, [cmd] + cmds

    def _get_head_refs(self, warn: bool) -> list[list[str]] | None:
        # Sub-repo config is not loaded in a git-dir, and without .gift there
        # is no sub-repo: skip the git process
        if self.in_git_dir or not os.path.isfile(self.confpath):
            return None

        super_git = self._super_git()
        try:
            lines = super_git.cmdf("show", "HEAD:" + refs_filename, flag=CMD_RAISE_STDOUT)
        except CalledProcessError:
            return None

        content = "\n".join(lines)
        try:
            return yaml.safe_load(content)
        except yaml.YAMLError as e:
            if warn:
                display(2, ["GIFT: can not parse " + refs_filename + " in HEAD:", str(e)])
            return None

    def x_clone_sub(self, cmds: list[str]) -> None:

        # TODO test remove is gift clone --sub ssh://git@github.com/openacid/celeritasdb.wiki wiki
        # there is a "@" in it.
        #
        # TODO test ".gift" without "remotes"
        # TODO test clone --sub
        if len(cmds) != 3:
            raise GiftError("usage: gift clone --sub <url>@<branch> <dir>")

        remote = cmds[1]
        subdir = cmds[2]
        # TODO overwrite existent conf?

        # As git clone does, read <dir> and a relative <url> from the cwd.
        # .gift holds them relative to the super repo root.
        subdir = os.path.relpath(pjoin(self.cwd, subdir), self.working_dir)
        url, sep, branch = remote.rpartition("@")
        if is_relative_path(url):
            url = os.path.relpath(pjoin(self.cwd, url), self.working_dir)
            if not url.startswith("../"):
                url = "./" + url
            remote = url + sep + branch

        conf = self.read_conf()
        conf["dirs"][subdir] = remote
        content = yaml.dump(conf, default_flow_style=False)

        # Commit .gift only after the clone works: a bad entry in HEAD would
        # break every later --sub command, in every clone
        old_content = None
        if os.path.isfile(self.confpath):
            old_content = fread(self.confpath)

        fwrite(self.confpath, content)
        try:
            self.init_git_config()
            self.check_worktree(self.conf["dirs"][subdir])
        except BaseException:
            if old_content is None:
                os.unlink(self.confpath)
            else:
                fwrite(self.confpath, old_content)
            raise

        super_git = self._super_git()
        super_git.cmdf("add", self.confpath, flag=CmdFlag.RAISE)
        super_git.cmdf("commit", self.confpath, "-m", "add sub repo: " + remote + " in " + subdir, flag=CmdFlag.RAISE)

        self.x_init_sub([])
        self.x_commit_sub([])

    def check_no_args(self, cmds: list[str]) -> None:
        args = cmds[1:]
        if args != []:
            raise GiftError(cmds[0] + " --sub accepts no argument, got: " + " ".join(args))

    def x_init_sub(self, cmds: list[str]) -> None:
        self.check_no_args(cmds)
        for subrepo in self.conf["dirs"].values():
            self.check_worktree(subrepo)

        try:
            content = fread(pjoin(self.working_dir, refs_filename))
        except IOError:
            # TODO message
            pass
        else:
            refs = yaml.safe_load(content)
            self._update_super_head_refs(refs)

    def x_commit_sub(self, cmds: list[str]) -> None:
        args = cmds[1:]
        msg = "commit subdirs"
        if len(args) == 2 and args[0] == "-m":
            msg = args[1]
        elif args != []:
            raise GiftError("commit --sub accepts only -m <msg>, got: " + " ".join(args))

        super_git = self._super_git(root=True)
        head_tree = super_git.tree_of("HEAD", flag=CmdFlag.RAISE)
        super_tree = head_tree
        parent = super_git.rev_of("HEAD")
        refs = []
        paths = []
        for subrepo in self.conf["dirs"].values():
            self.check_worktree(subrepo)
            super_tree, commit_hash = self._add_sub_tree(super_tree, subrepo)
            refs.append([subrepo["dir"], commit_hash])
            paths.append(pjoin(self.working_dir, subrepo["dir"]))

            # Other clones fetch sub-repo commits only from the remote
            remote_name = subrepo["upstream"]["name"]
            sub_git = self._sub_git(subrepo, bare=True)
            pushed_refs = sub_git.cmdf("for-each-ref", "--contains", commit_hash, "refs/remotes/" + remote_name,
                                       flag=CMD_RAISE_STDOUT)
            if pushed_refs == []:
                sub_git.out(2, "warning: commit", commit_hash, "is not pushed to", remote_name + ",",
                            "so other clones can not check it out")

        refs = sorted(refs)
        content = yaml.dump(refs, default_flow_style=False)
        refs_path = pjoin(self.working_dir, refs_filename)
        fwrite(refs_path, content)

        refs_blob = super_git.blob_new(refs_path, flag=CmdFlag.RAISE)
        super_tree = super_git.tree_add_obj(super_tree, refs_filename, refs_blob)

        if super_tree == head_tree:
            display(2, "GIFT: nothing to commit: no sub-repo changed")
            return

        new_commit = super_git.cmdf("commit-tree", "-p", parent, super_tree, input=msg, flag=CMD_RAISE_ONELINE)

        # Keep other staged changes: reset only the paths this commit changed
        super_git.cmdf("reset", new_commit, "--", refs_path, *paths, flag=CmdFlag.RAISE)
        super_git.cmdf("update-ref", "-m", "commit subdirs", "HEAD", new_commit, parent, flag=CmdFlag.RAISE)

        self._update_super_head_refs(refs)

    def x_fetch_sub(self, cmds: list[str]) -> None:
        self.check_no_args(cmds)
        for subrepo in self.conf["dirs"].values():
            self.check_worktree(subrepo)
            _, out, err = cmdx(self.gitpath, "fetch", subrepo["upstream"]["name"], env=subrepo["env"])
            display(out, err)

        # HEAD may record a sub-repo commit that only this fetch brought in
        refs = self._get_head_refs(warn=True)
        if refs is not None:
            self._update_super_head_refs(refs)

    def x_merge_sub(self, cmds: list[str]) -> None:
        self.check_no_args(cmds)
        # only ff-only allowed
        for subrepo in self.conf["dirs"].values():
            self.check_worktree(subrepo)
            _, out, err = cmdx(self.gitpath, "merge", "--ff-only", env=subrepo["env"])
            display(out, err)

    def x_reset_sub(self, cmds: list[str]) -> None:
        candidate_args = ['--soft',
                          '--mixed',
                          '-N',
                          '--hard',
                          '--merge',
                          '--keep',
                          '-q',
                          '--quiet', ]
        unknown = [arg for arg in cmds[1:] if arg not in candidate_args]
        if unknown != []:
            msg = "reset --sub accepts only " + ", ".join(candidate_args) + ", got: " + " ".join(unknown)
            raise GiftError(msg)

        args = []
        for arg in candidate_args:
            if arg in cmds:
                args.append(arg)

        for subrepo in self.conf["dirs"].values():
            self.check_worktree(subrepo)
            _, out, err = cmdx(self.gitpath, "reset", *args, super_head_ref, env=subrepo["env"])
            display(out, err)

    def _update_super_head_refs(self, refs: list[list[str]]) -> None:

        for subdir, commit_hash in refs:
            subrepo = self.conf["dirs"].get(subdir)
            if subrepo is None:
                continue

            # Not initialized yet: `gift init --sub` populates it
            if not os.path.isdir(subrepo["env"]["GIT_DIR"]):
                continue

            try:
                cmdx(self.gitpath, "update-ref", super_head_ref, commit_hash, env=subrepo["env"])
            except CalledProcessError as e:
                sub_git = self._sub_git(subrepo, bare=True)
                sub_git.out(2, "can not update", super_head_ref, "to", commit_hash)
                display(e.out, e.err)

    def _add_sub_tree(self, super_tree: str, subrepo: SubRepoConf) -> tuple[str, str]:
        super_git = self._super_git(root=True)

        # Without --no-tags, fetch also copies the sub-repo tags that point
        # into the fetched history
        super_git.cmdf("fetch", "--no-tags", subrepo["env"]["GIT_DIR"], "+HEAD:" + subrepo["refhead"], flag=CmdFlag.RAISE)

        sub_tree = super_git.tree_of(subrepo["refhead"], flag=CmdFlag.RAISE)
        super_tree = super_git.tree_add_obj(super_tree, subrepo["dir"], sub_tree)

        return super_tree, super_git.rev_of(subrepo["refhead"])


def parse_argv() -> tuple[GitOpt, int, list[str]]:
    args = sys.argv[1:]

    gitopt = GitOpt().parse_args(args, {'--gift-verbose': True})

    verbose = 0
    env_verbose = os.environ.get('GIFT_VERBOSE')
    if env_verbose is not None:
        verbose = int(env_verbose)

    if '--gift-verbose' in gitopt.additional:
        verbose = 1

    return gitopt, verbose, gitopt.cmds


if __name__ == "__main__":
    gitopt, verbose, cmds = parse_argv()

    dd("gift opt:", gitopt.opt)
    dd("gift cmds:", cmds)
    # TODO need to pass opt to delegated command
    # TODO test change remote/upstream['branch'] then init again.
    # TODO git box received a unexpected GIT_DIR env.
    # TODO test command such "git box": git-box: git rev-parse --git-dir
    gift = Gift(gitopt)

    # Every git process runs in this dir; fail as git -C does
    if not os.path.isdir(gift.cwd):
        reason = "No such file or directory"
        if os.path.exists(gift.cwd):
            reason = "Not a directory"
        display(2, "fatal: cannot change to '" + gift.cwd + "': " + reason)
        sys.exit(128)

    log_level = logging.INFO
    if verbose > 0:
        log_level = logging.DEBUG

    k3log.make_logger(
            fmt= '[%(asctime)s,%(filename)s,%(lineno)d,%(levelname)s] %(message)s',
            level=log_level)

    if cmds == [] and len(gitopt.informative_cmds) == 0:
        gift.exec_informative_cmd(['--help'])
        sys.exit(1)

    if cmds != [] and cmds[0] == 'gift-debug':
        display(1, ' '.join(cmds))
        display(1, yaml.dump({"opt": gitopt.opt,
                           "informative_cmds": gitopt.informative_cmds,
                           "additional": gitopt.additional},
                          default_flow_style=False))
        display(1, "evaluated cwd: " + str(gift.cwd))
        display(1, "evaluated git_dir: " + str(gift.git_dir))
        display(1, "evaluated working_dir: " + str(gift.working_dir))
        sys.exit(0)

    try:
        if len(gitopt.informative_cmds) > 0:
            gift.exec_informative_cmd(list(gitopt.informative_cmds))
        else:
            gift.run_command(cmds)
    except CalledProcessError as e:
        display(e.out, e.err)
        sys.exit(e.returncode)
    except GiftError as e:
        display(e.out, e.err)
        sys.exit(e.returncode)
    except KeyboardInterrupt:
        display(2, "user interrupted")
        sys.exit(1)
