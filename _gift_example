# Copy this file to .gift, then run `gift init --sub`.
#
# Each entry is <dir>: <url>@<branch>. gift checks out <branch> of <url> in
# <dir>. A relative url is relative to the dir of .gift.

dirs:
    deps/https/gift: https://github.com/drmingdrmer/gift.git@master
    deps/ssh/gift:   ssh://git@github.com/drmingdrmer/gift.git@master
    deps/scp/gift:   git@github.com:drmingdrmer/gift.git@master
    deps/local/gift: ../gift@master


# vim: ft=yaml
